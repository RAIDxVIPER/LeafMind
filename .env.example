# LeafMind — Environment Variables Template

LLM_PROVIDER=                # "gemini" or "ollama"  [REQUIRED at startup — R11]
GEMINI_API_KEY=               # Required when LLM_PROVIDER=gemini
OLLAMA_BASE_URL= 
OLLAMA_MODEL=          
OPENWEATHERMAP_API_KEY=        # Backup weather API key
CASE_STORE_PATH=data/cases
CHECKPOINT_DB_PATH=data/checkpoints.db
VECTOR_DB_PATH=vector_db/
LOG_LEVEL=INFO
